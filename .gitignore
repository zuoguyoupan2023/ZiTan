# 大模型二进制资产 → 上传 Cloudflare R2，不进入 git（部署见 006）
# 原则：网页代码走 Pages（git 管），模型/引擎二进制走 R2（git 不管），避免仓库膨胀 ~967MB
/sensevoice/model.int8.onnx
/sensevoice/silero_vad.onnx
/sensevoice/*.data
/sensevoice/*.wasm
/sensevoice/ort/*.wasm

# 归档的 sherpa 遗留大文件（历史备份，不上 git/不部署）
/archive/sherpa-sensevoice/*.data
/archive/sherpa-sensevoice/*.wasm
/archive/sherpa-sensevoice/silero_vad.onnx

# 系统/临时文件
.DS_Store

# Wrangler 本地联调临时目录（部署产物与缓存，不入 git）
.wrangler/
.wrangler-tmp/

# Wrangler 本地联调密钥（024：AZURE_SPEECH_KEY 等，绝不入 git）
.dev.vars

# Wrangler 本地联调运行时目录（配置/缓存重定向，防污染宿主）
.wrangler-tmp/

# Wrangler 本地状态（KV 模拟数据等，自动生成不入 git）
.wrangler/

# 本地依赖与 Miniflare 模拟器数据（node_modules/.mf/cf.json 等自动生成）
node_modules/
